{
  "name": "@dvaarik/setu",
  "version": "0.1.0",
  "description": "Open-source carrier bridge for AI voice agents: Twilio, Plivo, Exotel, FreJun/Teler, Vonage, Telnyx, SignalWire, jambonz and raw PCM.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./providers": "./dist/providers/index.js"
  },
  "bin": {
    "setu": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "voice-ai",
    "telephony",
    "twilio",
    "plivo",
    "exotel",
    "vonage",
    "telnyx",
    "jambonz",
    "sip",
    "media-streams",
    "websocket",
    "voice-agent",
    "ivr",
    "speech-to-speech",
    "india",
    "ai-voice-agent",
    "carrier-bridge",
    "india-telephony",
    "frejun",
    "teler",
    "signalwire",
    "pcm16",
    "barge-in"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvaarikai/setu.git"
  },
  "homepage": "https://developers.dvaarik.com",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
